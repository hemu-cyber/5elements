# LinkPulse Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real secrets to version control.

# --- Public Client Variables (Vite Bundle) ---
# Supabase project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"

# Supabase public anonymous API key (safe for browser distribution)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Base application URL (used for short link preview & QR codes)
VITE_SITE_URL="http://localhost:5173"


# --- Server-Only Secret Variables (Netlify Functions & Edge Functions) ---
# CRITICAL: Service-role key has full database privileges and bypasses RLS.
# NEVER prefix with VITE_ and NEVER expose to browser clients.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret..."

# Secret salt used for anonymized SHA-256 visitor hash generation (IP + UA + salt)
VISITOR_HASH_SALT="linkpulse-visitor-salt-change-in-production-random-32-chars"

# Secret key used for signing and verifying HttpOnly password unlock cookies
COOKIE_SECRET="linkpulse-cookie-hmac-secret-change-in-production-min-32-chars"
